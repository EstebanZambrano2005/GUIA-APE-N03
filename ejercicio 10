6. CODIGO JAVA

import java.util.Scanner;

/**
public class Ejercicio10 {

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        int opcion = 0;
        int totalVentas = 0;
        int totalUnidades = 0;
        double totalRecaudado = 0.0;
        double ventaMayor = 0.0;

        do {
            System.out.println("\n==========================================");
            System.out.println("     SISTEMA INTEGRADO DE VENTAS");
            System.out.println("==========================================");
            System.out.println("1) Registrar venta");
            System.out.println("2) Mostrar estadísticas");
            System.out.println("3) Salir");
            System.out.print("Seleccione una opción (1-3): ");

            if (scanner.hasNextInt()) {
                opcion = scanner.nextInt();
                scanner.nextLine(); // Limpiar el buffer de entrada
            } else {
                System.out.println("Error: Por favor ingrese un número entero del 1 al 3.");
                scanner.nextLine(); // Limpiar entrada no numérica
                continue;
            }

            switch (opcion) {
                case 1:
                    System.out.println("\n--- REGISTRO DE VENTA ---");
                    System.out.print("Ingrese el nombre del producto: ");
                    String nombreProducto = scanner.nextLine();

                    int cantidad = 0;
                    do {
                        System.out.print("Ingrese la cantidad de unidades (> 0): ");
                        if (scanner.hasNextInt()) {
                            cantidad = scanner.nextInt();
                            if (cantidad <= 0) {
                                System.out.println("Error: La cantidad debe ser mayor a 0.");
                            }
                        } else {
                            System.out.println("Error: Ingrese un valor entero válido.");
                            scanner.next();
                        }
                    } while (cantidad <= 0);

                    double precioUnitario = 0.0;
                    do {
                        System.out.print("Ingrese el precio unitario en $ (> 0): ");
                        if (scanner.hasNextDouble()) {
                            precioUnitario = scanner.nextDouble();
                            if (precioUnitario <= 0) {
                                System.out.println("Error: El precio debe ser mayor a 0.");
                            }
                        } else {
                            System.out.println("Error: Ingrese un número válido.");
                            scanner.next();
                        }
                    } while (precioUnitario <= 0);

                    // Cálculos de la venta actual
                    double montoVenta = cantidad * precioUnitario;
                    totalVentas++;
                    totalUnidades += cantidad;
                    totalRecaudado += montoVenta;

                    if (totalVentas == 1 || montoVenta > ventaMayor) {
                        ventaMayor = montoVenta;
                    }

                    System.out.printf("-> Venta de '%s' registrada con éxito. Total: $%.2f%n", nombreProducto, montoVenta);
                    break;

                case 2:
                    System.out.println("\n==========================================");
                    System.out.println("       ESTADÍSTICAS DE VENTAS");
                    System.out.println("==========================================");

                    if (totalVentas == 0) {
                        System.out.println("No se han registrado ventas en el sistema aún.");
                    } else {
                        double promedioVenta = totalRecaudado / totalVentas;
                        System.out.println("Número de ventas realizadas: " + totalVentas);
                        System.out.println("Total de unidades vendidas:  " + totalUnidades);
                        System.out.printf("Total recaudado:            $%.2f%n", totalRecaudado);
                        System.out.printf("Venta mayor:                $%.2f%n", ventaMayor);
                        System.out.printf("Promedio por venta:         $%.2f%n", promedioVenta);
                    }
                    break;

                case 3:
                    System.out.println("\nGracias por utilizar el sistema. ¡Hasta pronto!");
                    break;

                default:
                    System.out.println("Opción inválida. Seleccione una opción válida (1, 2 o 3).");
                    break;
            }

        } while (opcion != 3);

        scanner.close();
    }
}
