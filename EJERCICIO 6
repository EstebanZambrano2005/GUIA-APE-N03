Ejercicio 6: Estadísticas de un curso

Análisis

Entradas: n y las notas.
Proceso:
Un Para recorre a los N estudiantes.
Un Repetir...Hasta Que interno valida que la nota esté en [0, 10].
Se acumula la suma y se buscan el mayor y el menor.
Se cuentan aprobados (nota >= 7) y reprobados.
Se calculan promedio y porcentajes.
Salidas: promedio, mayor, menor, cantidad y % de aprobados, cantidad y % de reprobados.

Pseudocódigo:
Algoritmo EstadisticasCurso
    Definir n, i, ap, rep Como Entero
    Definir nota, suma, mayor, menor Como Real
    Definir promedio, pAp, pRep Como Real
    suma <- 0
    mayor <- -1
    menor <- 11
    ap <- 0
    rep <- 0
    Escribir "Ingrese el número de estudiantes: "
    Leer n
    Para i <- 1 Hasta n Con Paso 1 Hacer
        Repetir
            Escribir "Nota del estudiante ", i, " (0-10): "
            Leer nota
        Hasta Que nota >= 0 Y nota <= 10
        suma <- suma + nota
        Si nota > mayor Entonces
            mayor <- nota
        FinSi
        Si nota < menor Entonces
            menor <- nota
        FinSi
        Si nota >= 7 Entonces
            ap <- ap + 1
        SiNo
            rep <- rep + 1
        FinSi
    FinPara
    promedio <- suma / n
    pAp <- ap * 100 / n
    pRep <- rep * 100 / n
    Escribir "Promedio: ", promedio
    Escribir "Nota mayor: ", mayor
    Escribir "Nota menor: ", menor
    Escribir "Aprobados: ", ap, " (", pAp, "%)"
    Escribir "Reprobados: ", rep, " (", pRep, "%)"
FinAlgoritmo

Código JAVA
import java.util.Scanner;
 
public class Ejercicio6 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n, i, ap = 0, rep = 0;
        double nota, suma = 0, mayor = -1, menor = 11;
        double promedio, pAp, pRep;
 
        System.out.print("Ingrese el número de estudiantes: ");
        n = sc.nextInt();
 
        for (i = 1; i <= n; i++) {
            // Repetir ... Hasta Que nota esté en [0, 10]
            do {
                System.out.print("Nota del estudiante " + i + " (0-10): ");
                nota = sc.nextDouble();
            } while (!(nota >= 0 && nota <= 10));
 
            suma = suma + nota;
 
            if (nota > mayor) {
                mayor = nota;
            }
            if (nota < menor) {
                menor = nota;
            }
            if (nota >= 7) {
                ap++;
            } else {
                rep++;
            }
        }
 
        promedio = suma / n;
        pAp = ap * 100.0 / n;
        pRep = rep * 100.0 / n;
 
        System.out.println("Promedio: " + promedio);
        System.out.println("Nota mayor: " + mayor);
        System.out.println("Nota menor: " + menor);
        System.out.println("Aprobados: " + ap + " (" + pAp + "%)");
        System.out.println("Reprobados: " + rep + " (" + pRep + "%)");
 
        sc.close();
    }
}
